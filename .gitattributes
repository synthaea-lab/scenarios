# Line endings each file type needs on the machine that runs it.
# Shell scripts are rsynced verbatim into Linux guests: a lone \r breaks every command.
*.sh   text eol=lf
*.bash text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Scenario sidecars are content-hashed (ADR-0009 scenario_yaml_sha256): CRLF would
# silently invalidate every model record bound to them.
scenarios/*.yaml text eol=lf
# Its manifest is parsed line by line by tools/check-sidecar-bytes.py.
scenarios/sidecars.sha256 text eol=lf
